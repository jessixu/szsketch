generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(50)
  displayName  String   @map("display_name") @db.VarChar(50)
  passwordHash String   @map("password_hash")
  className    String?  @map("class_name") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  history      History[]
  portfolioUploads PortfolioUpload[]
  learningReports  LearningReport[]

  @@map("users")
}

model History {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  origin      String   @db.VarChar(100)
  mood        String   @db.VarChar(50)
  patterns    String   @default("[]") @db.VarChar(500)
  notes       String   @db.Text
  prompt      String   @db.Text
  imageUrl    String?  @map("image_url") @db.Text
  description String?  @db.Text
  aiAvailable Boolean  @default(false) @map("ai_available")
  courseKey   String   @default("shanhaijing") @map("course_key") @db.VarChar(50)
  actionKey   String   @default("generate") @map("action_key") @db.VarChar(50)
  paramsJson  String?  @map("params_json") @db.Text
  outputImages String? @map("output_images") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("history")
}

model PortfolioUpload {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  courseKey String   @map("course_key") @db.VarChar(50)
  imageUrl  String   @map("image_url") @db.Text
  note      String   @default("") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseKey])
  @@index([userId])
  @@map("portfolio_uploads")
}

model LearningReport {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  shareToken String   @unique @map("share_token") @db.VarChar(100)
  status     String   @default("ready") @db.VarChar(30)
  reportJson String   @map("report_json") @db.LongText
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("learning_reports")
}
