# Environment Variables
# Copy to .env and fill in your values

# MySQL
DATABASE_URL="mysql://root:password@localhost:3306/szsketch"

# Session
SESSION_SECRET="change-me-to-a-random-64-char-string"

# Volcano Engine / Seedream (leave empty to disable AI)
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_HOST=visual.volcengineapi.com
VOLC_REGION=cn-north-1

# Upload
UPLOAD_DIR=./uploads
