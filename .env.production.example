# Production environment for aiprint.hichara.com
# Copy this file to /www/wwwroot/aiprint.hichara.com/.env.production on ECS

NODE_ENV=production

# MySQL / RDS
DATABASE_URL="mysql://root:password@your-rds-host:3306/szsketch"

# Session
SESSION_SECRET="change-me-to-a-random-64-char-string"
# Keep true for HTTPS production domains. Set false only for temporary HTTP/IP verification.
SESSION_COOKIE_SECURE="true"

# AI APIs
ARK_API_KEY=""
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
ARK_IMAGE_SIZE="2K"
ARK_OUTPUT_FORMAT="jpeg"
# Return Ark image URL immediately. Set true to download every generated image into UPLOAD_DIR before responding.
SAVE_GENERATED_IMAGE="false"
GLM_API_KEY=""

# Uploads
UPLOAD_DIR="/www/wwwroot/aiprint.hichara.com/uploads"
