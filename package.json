{
  "name": "szsketch",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "postbuild": "node ./scripts/prepare-standalone.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "release:start": "bash ./scripts/release/git-flow.sh start-release",
    "release:verify": "npm run test:deploy-readiness && npm run lint && npm run build",
    "release:finish": "bash ./scripts/release/git-flow.sh finish-release",
    "hotfix:start": "bash ./scripts/release/git-flow.sh start-hotfix",
    "hotfix:finish": "bash ./scripts/release/git-flow.sh finish-hotfix",
    "deploy:prod": "bash ./deploy.sh",
    "test:deploy-readiness": "node ./scripts/test-deploy-readiness.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@prisma/client": "^6.19.3",
    "@volcengine/openapi": "^1.36.1",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
