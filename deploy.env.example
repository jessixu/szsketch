# ECS / SSH connection info for production deploy
# Copy to deploy.env.local and fill it locally only. Do not commit deploy.env.local.

# ECS public IP or SSH host
ECS_PUBLIC_IP=43.134.183.223

# Remote SSH user
REMOTE_USER=ubuntu

# SSH auth. Prefer SSH_KEY_PATH when a key is available.
# If using password login, set SSH_PASSWORD only in deploy.env.local.
SSH_KEY_PATH=
SSH_PASSWORD=

# Local repo root
PROJECT_DIR=/Users/jessi/ai-project/szsketch

# Target project directory on ECS
REMOTE_PROJECT_DIR=/var/www/szsketch

# Production env file on ECS
REMOTE_ENV_FILE=/var/www/szsketch/.env

# PM2 app name
PM2_APP_NAME=szsketch

# Remote health check URL
HEALTHCHECK_URL=http://127.0.0.1:3000/api/health
