# ECS / SSH connection info for production deploy
# Copy to deploy.env.local and fill it locally only. Do not commit deploy.env.local.

# ECS public IP or SSH host
ECS_PUBLIC_IP=__REPLACE_WITH_ECS_IP__

# SSH private key path
SSH_KEY_PATH=~/.ssh/__REPLACE_WITH_PRIVATE_KEY__

# Local repo root
PROJECT_DIR=/absolute/path/to/szsketch

# Remote SSH user
REMOTE_USER=root

# Target project directory on ECS
REMOTE_PROJECT_DIR=/www/wwwroot/aiprint.hichara.com

# Production env file on ECS
REMOTE_ENV_FILE=/www/wwwroot/aiprint.hichara.com/.env.production

# PM2 app name
PM2_APP_NAME=aiprint-web

# Remote health check URL
HEALTHCHECK_URL=http://127.0.0.1:3000/api/health
